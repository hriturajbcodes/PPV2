diff --git a/app/globals.css b/app/globals.css
index 907ff86..c41d868 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -194,3 +194,65 @@ html[data-theme="light"] .insights-top h1 em,html[data-theme="light"] .forecast-
 html[data-theme="light"] .interactive-chart{background:radial-gradient(circle at 50% 100%,rgba(45,140,255,.055),transparent 45%),#fff}
 
 @media(prefers-reduced-motion:reduce){.motion-card,.insight-row,.state-live:before,.bin-starving .state-dot,.bin-overfeed .state-dot{animation:none!important}.bin,.vessel .fill,.actions button,.toolbar button,.chart-tools button,.bins button,.track i{transition:none!important}}
+
+
+/* Header cleanup + KPI separator removal */
+.kpi footer{
+  border-top:0!important;
+}
+
+.actions .insights-button{
+  height:34px;
+  display:inline-flex;
+  align-items:center;
+  justify-content:center;
+  gap:6px;
+  padding:0 12px;
+  border:1px solid #2a343d;
+  border-radius:5px;
+  background:#0b0e11;
+  color:#9eb5ca;
+  text-decoration:none;
+  font-family:var(--font-inter),Inter,Arial,sans-serif;
+  font-size:10px;
+  font-weight:650;
+  letter-spacing:.01em;
+  white-space:nowrap;
+  transition:background .16s ease,border-color .16s ease,color .16s ease,transform .12s ease;
+}
+.actions .insights-button span{
+  font-size:12px;
+  line-height:1;
+  transition:transform .16s ease;
+}
+.actions .insights-button:hover{
+  background:#131a20;
+  border-color:#526878;
+  color:#fff;
+  transform:translateY(-1px);
+}
+.actions .insights-button:hover span{
+  transform:translate(2px,-2px);
+}
+.actions .insights-button:active{
+  transform:scale(.97);
+}
+
+html[data-theme="light"] .innovation strong{
+  color:#17212a!important;
+}
+html[data-theme="light"] .innovation span{
+  color:#66829d!important;
+}
+html[data-theme="light"] .innovation b{
+  color:#147bd1!important;
+}
+html[data-theme="light"] .actions .insights-button{
+  background:#15202a!important;
+  border-color:#15202a!important;
+  color:#fff!important;
+}
+html[data-theme="light"] .actions .insights-button:hover{
+  background:#263746!important;
+  border-color:#263746!important;
+}
