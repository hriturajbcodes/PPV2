diff --git a/app/globals.css b/app/globals.css
--- a/app/globals.css
+++ b/app/globals.css
@@ -1,0 +1,45 @@
+/* Pellet Plant executive wordmark */
+.brand-title{
+  display:flex;
+  align-items:baseline;
+  gap:8px;
+  white-space:nowrap;
+  font-family:var(--font-inter),Inter,Arial,sans-serif!important;
+  font-size:clamp(22px,1.7vw,29px)!important;
+  font-weight:500!important;
+  line-height:1!important;
+  letter-spacing:-.045em!important;
+  color:#f5f7f9!important;
+}
+
+.brand-title span{
+  font:inherit;
+}
+
+.brand-title em{
+  font-family:var(--font-editorial),Georgia,serif!important;
+  font-size:1.08em;
+  font-weight:400!important;
+  font-style:italic;
+  line-height:1;
+  letter-spacing:-.035em;
+  color:#8ca8c1!important;
+}
+
+html[data-theme="light"] .brand-title{
+  color:#121a21!important;
+}
+
+html[data-theme="light"] .brand-title em{
+  color:#587691!important;
+}
+
+@media(min-width:1600px){
+  .brand-title{
+    font-size:clamp(25px,1.55vw,31px)!important;
+    gap:9px;
+  }
+}
+
+@media(max-width:1200px){
+  .brand-title{
+    font-size:21px!important;
+    gap:6px;
+  }
+}